{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=marketing_manager;Username=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "MarketingManager",
    "Audience": "MarketingManagerClients"
  },
  "Caching": {
    "UseRedis": false
  },
  "Database": {
    "AutoMigrate": true
  },
  "BackgroundTasks": {
    "CountProductsEnabled": true
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "Port": 587
  }
}
